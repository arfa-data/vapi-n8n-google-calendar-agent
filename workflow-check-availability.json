      "parameters": {
        "jsCode": "// Extract tool call ID from original Vapi webhook input\nconst vapiMessage = $('vapi-check-availability').first().json.body.message;\nconst toolCallId = vapiMessage.toolCalls[0].id;\n\n// Check if items array exists and has length\nconst events = $input.first().json.items || [];\nconst isAvailable = events.length === 0;\n\nconst resultText = isAvailable \n  ? \"The requested time slot is completely available.\" \n  : \"The requested time slot is busy. Please pick another time.\";\n\nreturn {\n  json: {\n    results: [\n      {\n        toolCallId: toolCallId,\n        result: resultText\n      }\n    ]\n  }\n};"
