      "parameters": {
        "jsCode": "const toolCalls = $input.first().json.body.message.toolCalls;\nconst rawTime = toolCalls[0].function['arguments'].dateTime;\n\n// Clean ISO string format without milliseconds\nconst startTime = new Date(rawTime).toISOString().replace(/\\.\\d{3}Z$/, 'Z');\nconst endTime = new Date(new Date(rawTime).getTime() + 60 * 60 * 1000).toISOString().replace(/\\.\\d{3}Z$/, 'Z');\n\nreturn {\n  json: {\n    timeMin: startTime,\n    timeMax: endTime\n  }\n};"
      },
